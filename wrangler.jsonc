{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeitinhovibe",
  "account_id": "9b30dc9ed19dff935fa4e6a6cb4ae6a7",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "jeitinhovibe.online",
      "custom_domain": true,
      // Per-PR previews get <preview>.jeitinhovibe.online, with the wildcard
      // DNS record and certificate created by Cloudflare.
      "previews_enabled": true
    }
  ],
  // Enables `wrangler preview`, used by the shared PR-preview workflow.
  "previews": {},
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
